<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == "/" %}{{ site.name }}{% else %}{{ title }} | {{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="icon" href="{{ "/pictures/favicon.ico" | url }}" sizes="any">
<link rel="icon" href="{{ "/pictures/favicon.png" | url }}" type="image/png">
<link rel="apple-touch-icon" href="{{ "/pictures/apple-touch-icon.png" | url }}">
<link rel="stylesheet" href="{{ "/styles.css" | url }}">
<script>document.documentElement.classList.add("js-enabled");</script>
</head>
<body data-page="{{ navId or 'home' }}">

<a class="skip-link" href="#content">Skip to content</a>

<header class="site-header">
  <a class="brand" data-nav="home" href="{{ "/index.html" | url }}">
    <span class="brand-mark logo-mark"><img alt="" src="{{ "/pictures/logos/tpi-starburst-black.svg" | url }}"></span>
    <span class="brand-text">
      <span>{{ site.name }}</span>
      <span>{{ site.parent }}</span>
    </span>
  </a>

  <nav class="primary-nav" aria-label="Main">
    {%- for item in site.nav %}
    <a href="{{ item.href | url }}"{% if navId == item.id %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>

  <div class="header-actions">
    <a class="gift-link" href="{{ site.giftUrl }}">Make a Gift</a>
  </div>
</header>

<main id="content">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div>
    <a class="brand footer-brand" data-nav="home" href="{{ "/index.html" | url }}">
      <span class="brand-mark logo-mark"><img alt="" src="{{ "/pictures/logos/tpi-starburst-black.svg" | url }}"></span>
      <span class="brand-text">
        <span>{{ site.name }}</span>
        <span>{{ site.parent }}</span>
      </span>
    </a>
    <img alt="Cornell Brooks Public Policy Tech Policy Institute" class="footer-cobrand-logo" src="{{ "/pictures/logos/tpi-brooks-logo-clean.png" | url }}">
    <p>{{ site.address | safe }}</p>
  </div>
  <div class="footer-links">
    {%- for item in site.footerLinks %}
    <a href="{{ item.href | url }}">{{ item.label }}</a>
    {%- endfor %}
    <a href="{{ site.giftUrl }}">Make a Gift</a>
  </div>
</footer>

<script src="{{ "/script.js" | url }}"></script>
</body>
</html>
