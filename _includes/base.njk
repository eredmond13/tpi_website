<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == "/" %}{{ site.name }}{% else %}{{ title }} | {{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="icon" href="{{ "/pictures/favicon.ico" | url }}" sizes="any">
<link rel="icon" href="{{ "/pictures/favicon.png" | url }}" type="image/png">
<link rel="apple-touch-icon" href="{{ "/pictures/apple-touch-icon.png" | url }}">
<link rel="stylesheet" href="{{ "/styles.css" | url }}">
<script>document.documentElement.classList.add("js-enabled");</script>
</head>
<body data-page="{{ navId or 'home' }}">

<a class="skip-link" href="#content">Skip to content</a>

<header class="site-header">
  <a class="brand" data-nav="home" href="{{ "/index.html" | url }}">
    <span class="brand-mark logo-mark"><img alt="" src="{{ "/pictures/logos/tpi-starburst-black.svg" | url }}"></span>
    <span class="brand-text">
      <span>{{ site.name }}</span>
      <span>{{ site.parent }}</span>
    </span>
  </a>

  <nav class="primary-nav" aria-label="Main">
    {%- for item in site.nav %}
    <a href="{{ item.href | url }}"{% if navId == item.id %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>

  <div class="header-actions">
    <a class="gift-link" href="{{ site.giftUrl }}">Make a Gift</a>
  </div>
</header>

<main id="content">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div>
    <a class="footer-brand" data-nav="home" href="{{ "/index.html" | url }}">
      <img alt="" class="footer-mark" src="{{ "/pictures/logos/tpi-starburst-black.svg" | url }}">
      <span class="footer-name">{{ site.name }}</span>
    </a>
    <p>{{ site.address | safe }}</p>
    {%- if site.social %}
    <div class="footer-social">
      {%- for item in site.social %}
      <a href="{{ item.href }}" target="_blank" rel="noopener" aria-label="{{ item.label }}" title="{{ item.label }}">
        {%- if item.icon == "linkedin" -%}
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
        {%- elif item.icon == "x" -%}
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM17.61 20.644h2.039L6.486 3.24H4.298z"/></svg>
        {%- else -%}
        {{ item.label }}
        {%- endif -%}
      </a>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
  <div class="footer-links">
    {%- for item in site.footerLinks %}
    <a href="{{ item.href | url }}">{{ item.label }}</a>
    {%- endfor %}
    <a href="{{ site.giftUrl }}">Make a Gift</a>
  </div>
</footer>

<script src="{{ "/script.js" | url }}"></script>
</body>
</html>
