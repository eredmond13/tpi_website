---
layout: base.njk
navId: research
pagination:
  data: hubs
  size: 1
  alias: hub
permalink: "/research/{{ hub.slug }}.html"
eleventyComputed:
  title: "{{ hub.name }}"
  description: "{{ hub.dek }}"
---
<section class="page-hero">
  <p class="eyebrow">Research hub</p>
  <h1>{{ hub.name }}</h1>
  <p class="dek">{{ hub.dek }}</p>
</section>

{% if hub.image %}
<figure class="hub-hero">
  <img alt="{{ hub.imageAlt }}" src="{{ hub.image | url }}">
  {% if hub.imageCredit %}<figcaption>{{ hub.imageCredit | safe }}</figcaption>{% endif %}
</figure>
{% endif %}

<section class="page-block hub-block" id="about-hub">
  <div class="hub-intro">
    <div class="hub-body">
      {%- for para in hub.intro %}
      <p>{{ para }}</p>
      {%- endfor %}
    </div>
  </div>
</section>

{% if hub.nodes.length %}
<section class="page-block hub-block" id="nodes">
  <div class="block-header">
    <p class="section-label">Within this hub</p>
    <h2>Research nodes</h2>
  </div>
  <div class="node-grid">
  {%- for node in hub.nodes %}
    <article class="node">
      <h3>{{ node.name }}</h3>
      <p>{{ node.text }}</p>
    </article>
  {%- endfor %}
  </div>
</section>
{% endif %}

{#- Hub team. A person joins a hub with a "hubs:" line in their profile, and
    leads it with a "hubLead:" line. Leads come first, then everyone else in
    order of seniority, using the same group order as the People page. -#}
{%- set SENIORITY = ["Leadership", "Staff", "Senior Fellows", "Fellows", "Junior Fellows", "Alumni"] %}
{%- set leads = [] %}
{%- set members = [] %}
{%- for rank in SENIORITY %}
  {%- for person in collections.person | byOrder %}
    {%- if person.data.group == rank %}
      {%- if hub.slug in (person.data.hubLead or []) %}
        {%- set leads = (leads.push(person), leads) %}
      {%- elif hub.slug in (person.data.hubs or []) %}
        {%- set members = (members.push(person), members) %}
      {%- endif %}
    {%- endif %}
  {%- endfor %}
{%- endfor %}
{%- set team = leads.concat(members) %}

{% if team.length %}
<section class="page-block hub-block" id="team">
  <div class="block-header">
    <p class="section-label">Team</p>
    <h2>Who works on this</h2>
  </div>

  <div class="team-strip{% if team.length > 5 %} is-slider{% endif %}">
    <div class="team-track">
    {%- for person in team %}
      {#- a hairline in the gap where the leads end and the rest of the team begins -#}
      <a class="team-card{% if leads.length and loop.index0 == leads.length %} starts-members{% endif %}" href="{{ "/people.html" | url }}#{{ person.fileSlug }}">
        {% if person.data.photo %}<img alt="{{ person.data.name }}" src="{{ person.data.photo | url }}">
        {% else %}<span class="team-nophoto" aria-hidden="true"></span>{% endif %}
        <p class="team-name">{{ person.data.name }}</p>
        <p class="team-role">{% if hub.slug in (person.data.hubLead or []) %}Hub Lead{% else %}{{ person.data.role }}{% endif %}</p>
      </a>
    {%- endfor %}
    </div>
    {% if team.length > 5 %}
    <div class="team-controls">
      <button type="button" class="team-arrow" data-dir="-1" aria-label="Scroll team left">&larr;</button>
      <button type="button" class="team-arrow" data-dir="1" aria-label="Scroll team right">&rarr;</button>
    </div>
    {% endif %}
  </div>
</section>

<script>
/* The strip scrolls natively, so it works without this. The arrows just make
   that obvious on a desktop where there is no touch to swipe with. */
(function () {
  document.querySelectorAll(".team-strip.is-slider").forEach(function (strip) {
    var track = strip.querySelector(".team-track");
    strip.querySelectorAll(".team-arrow").forEach(function (btn) {
      btn.addEventListener("click", function () {
        track.scrollBy({ left: Number(btn.dataset.dir) * track.clientWidth * 0.8, behavior: "smooth" });
      });
    });
    function sync() {
      var max = track.scrollWidth - track.clientWidth - 2;
      strip.querySelectorAll(".team-arrow").forEach(function (b) {
        b.disabled = Number(b.dataset.dir) < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
      });
    }
    track.addEventListener("scroll", sync);
    window.addEventListener("resize", sync);
    sync();
  });
})();
</script>
{% endif %}



{%- set hubPubs = [] %}
{%- set hubNews = [] %}
{%- for post in collections.article | newest %}
  {%- if hub.slug in (post.data.hubs or []) %}
    {%- if post.data.category in ["Report", "Op-ed", "Policy brief", "Policy infographic"] %}
      {%- set hubPubs = (hubPubs.push(post), hubPubs) %}
    {%- else %}
      {%- set hubNews = (hubNews.push(post), hubNews) %}
    {%- endif %}
  {%- endif %}
{%- endfor %}

{% if hubPubs.length %}
<section class="page-block hub-block" id="publications">
  <div class="block-header">
    <p class="section-label">Publications</p>
    <h2>From this hub</h2>
  </div>
  <div class="news-list">
  {%- for post in hubPubs %}
    <article>
      {% if post.data.image %}<a class="article-thumb" href="{{ post.url | url }}"><img alt="{{ post.data.imageAlt }}" src="{{ post.data.image | url }}"></a>
      {% else %}<a class="article-thumb is-placeholder" href="{{ post.url | url }}" aria-hidden="true"><span>{{ post.data.category }}</span></a>{% endif %}
      <time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time>
      <p class="article-tag">{{ post.data.category }}</p>
      <h3><a href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
      <p>{{ post.data.summary }}</p>
    </article>
  {%- endfor %}
  </div>
</section>
{% endif %}

{% if hubNews.length %}
<section class="page-block hub-block" id="news">
  <div class="block-header">
    <p class="section-label">News</p>
    <h2>News and events</h2>
  </div>
  <div class="news-list">
  {%- for post in hubNews %}
    <article{% if loop.index0 >= 8 %} class="is-extra" hidden{% endif %}>
      {%- set href = post.data.externalUrl if post.data.externalUrl else (post.data.interviewLink | url if post.data.interviewLink else post.url | url) %}
      {%- set away = ' target="_blank" rel="noopener"' if post.data.externalUrl else "" %}
      {% if post.data.image %}<a class="article-thumb" href="{{ href }}"{{ away | safe }}><img alt="{{ post.data.imageAlt }}" src="{{ post.data.image | url }}"></a>
      {% else %}<a class="article-thumb is-placeholder" href="{{ href }}"{{ away | safe }} aria-hidden="true"><span>{{ post.data.category }}</span></a>{% endif %}
      <time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time>
      <p class="article-tag">{{ post.data.category }}{% if post.data.sourceName %} &middot; {{ post.data.sourceName }}{% endif %}</p>
      <h3><a href="{{ href }}"{{ away | safe }}>{{ post.data.title }}</a></h3>
      <p>{{ post.data.summary }}</p>
    </article>
  {%- endfor %}
  </div>
  {% if hubNews.length > 8 %}
  <p class="link-row"><button type="button" class="show-all">Show all {{ hubNews.length }} news items</button></p>
  {% endif %}
</section>

<script>
/* Everything is in the page already, so with JavaScript off the full list is
   visible and nothing is hidden from anyone. */
(function () {
  var btn = document.querySelector(".show-all");
  if (!btn) return;
  btn.addEventListener("click", function () {
    document.querySelectorAll(".news-list article.is-extra").forEach(function (el) { el.hidden = false; });
    btn.remove();
  });
})();
</script>
{% endif %}

<p class="link-row"><a href="{{ "/research.html" | url }}">All research hubs</a></p>
